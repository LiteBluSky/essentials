# Nothing here is required: copy to .env.local only to change a default.

# SQLite database file (optional, default data/essentials.db, relative to the
# project root). Created with its tables on first start.
# DATABASE_PATH="data/essentials.db"

# Don't set PORT here: it would also move `pnpm dev` off 3000. The production
# port (8008) is set by scripts/start.ps1 (see README).

# Name shown in the header and browser tab (optional, default "Essentials").
# Build-time: restart dev / rebuild after changing it.
# VITE_APP_NAME="Essentials"

# The assistant and reminder settings below are normally set in the app
# (⋮ menu → Settings…, stored in the database). These env vars are only a
# fallback for anything not saved there.

# ---- Assistant: the "Tell me…" field (optional) --------------------------
# Type or dictate "remind me to call the dentist Friday at 3" and it becomes a
# task (or a note) in the "Unsorted" folder. Without a key the field isn't
# shown and nothing is sent anywhere. The sentence (not your data) is sent to
# the LLM provider. Any OpenAI-compatible API works; OpenRouter by default.
# LLM_PROVIDER="openai"   # or "anthropic" (then LLM_BASE_URL is ignored)
# LLM_API_KEY="sk-or-..."
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="anthropic/claude-haiku-5.5"

# ---- Phone reminders via ntfy (optional) ---------------------------------
# When a task falls due, a push goes to this ntfy topic; subscribe to it in
# the ntfy app (Android / iOS). Without a topic no reminders are sent. On
# ntfy.sh anyone who knows the topic name can read it: use a long random one,
# or your own ntfy server (+ NTFY_TOKEN if it needs a login).
# NTFY_TOPIC="essentials-k3j9x2q7v8m4"
# NTFY_URL="https://ntfy.sh"
# NTFY_TOKEN=""
# Where tapping a reminder opens the app (optional), e.g. your Tailscale URL.
# PUBLIC_URL="https://my-pc.tailnet.ts.net"
